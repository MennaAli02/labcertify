<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Certificate List View -->
    <record id="view_lab_certificate_list" model="ir.ui.view">
        <field name="name">lab.certificate.list</field>
        <field name="model">lab.certificate</field>
        <field name="arch" type="xml">
            <list string="Digital Certificates">
                <field name="certificate_id"/>
                <field name="employee_id"/>
                <field name="trainee_name"/>
                <field name="course_code"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
                <field name="score"/>
                <field name="status" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Certificate Form View -->
    <record id="view_lab_certificate_form" model="ir.ui.view">
        <field name="name">lab.certificate.form</field>
        <field name="model">lab.certificate</field>
        <field name="arch" type="xml">
            <form string="Digital Certificate">
                <sheet>
                    <div class="oe_title">
                        <label for="certificate_id" string="Certificate Number"/>
                        <h1><field name="certificate_id"/></h1>
                    </div>
                    <group>
                        <group string="Recipient Information">
                            <field name="trainee_id"/>
                            <field name="trainee_name"/>
                            <field name="trainee_name_ar"/>
                            <field name="employee_id"/>
                        </group>
                        <group string="Accreditation &amp; Scores">
                            <field name="course_id"/>
                            <field name="course_code"/>
                            <field name="score"/>
                            <field name="passing_score"/>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="verification_code"/>
                            <field name="status"/>
                            <field name="authorized_signer"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_lab_certificate" model="ir.actions.act_window">
        <field name="name">Digital Certificates</field>
        <field name="res_model">lab.certificate</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
